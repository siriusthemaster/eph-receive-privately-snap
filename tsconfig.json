{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@metamask/snaps-sdk",
    "types": ["jest"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "snap.config.ts"]
}
